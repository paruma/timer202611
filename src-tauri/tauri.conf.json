{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Timer",
  "version": "0.1.0",
  "identifier": "com.paruma.focus-timer",
  "build": {
    "beforeDevCommand": "pnpm run prepare:frontend",
    "beforeBuildCommand": "pnpm run prepare:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "タイマー",
        "dragDropEnabled": false,
        "width": 260,
        "height": 320,
        "minWidth": 240,
        "minHeight": 280,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
